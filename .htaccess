RewriteEngine On
Options -Indexes

# Si es un archivo o directorio existente (incluyendo api, assets, uploads), servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás pasarlo a core/route.php
RewriteRule ^(.*)$ core/route.php [QSA,L]
